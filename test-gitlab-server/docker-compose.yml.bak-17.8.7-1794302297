# Fake seeded GitLab for the upgrade demo. Everything (volumes, backups,
# settings) lives in this folder. Run: ./setup.sh
name: test-gitlab-server

services:
  gitlab:
    image: gitlab/gitlab-ce:17.5.5-ce.0
    container_name: test-gitlab-server
    hostname: gitlab.local
    restart: unless-stopped
    shm_size: 256m
    ports:
      - "${GITLAB_HTTP_PORT:-8080}:80"
      - "${GITLAB_HTTPS_PORT:-8443}:443"
      - "${GITLAB_SSH_PORT:-2222}:22"
    volumes:
      - ./volumes/config:/etc/gitlab:Z
      - ./volumes/logs:/var/log/gitlab:Z
      - ./volumes/data:/var/opt/gitlab:Z
    environment:
      # nginx must listen on the CONTAINER port (80); external_url carries the
      # HOST port. Without listen_port, omnibus listens on external_url's port
      # inside the container and the HOST->80 mapping hits nothing (RST).
      GITLAB_OMNIBUS_CONFIG: |
        external_url '${GITLAB_URL:-http://localhost:8080}';
        nginx['listen_port'] = 80;
        gitlab_rails['gitlab_shell_ssh_port'] = ${GITLAB_SSH_PORT:-2222};
        # /-/health, /-/liveness, /-/readiness and /health_check all 404 unless
        # the client IP is allowlisted (default: localhost only). Host-side curls
        # reach the container via the Docker bridge gateway (172.x), not
        # localhost, so allow the whole default Docker range. Fine for a
        # localhost demo box; tighten for anything exposed.
        gitlab_rails['monitoring_whitelist'] = ['127.0.0.0/8', '::1/128', '172.16.0.0/12'];
      GITLAB_ROOT_PASSWORD: ${GITLAB_ROOT_PASSWORD:?Copy .env.example to .env and set GITLAB_ROOT_PASSWORD}
