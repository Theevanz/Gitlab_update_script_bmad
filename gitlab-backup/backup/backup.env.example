# backup.env.example — example values for the POC checkout.
#
# Copy this file to backup.env and edit it; never commit backup.env itself.
# Precedence: real environment variables > backup.env > built-in POC defaults.
# This file holds KEY PATHS, never key material.
# Replace /path/to/checkout with your checkout root. Most *-DIR and key paths
# derive from COMPOSE_FILE's directory when left unset (see gitlab-backup.sh
# resolve_config); they are listed here explicitly so every variable is visible.

# COMPOSE_FILE — the pinned-version recipe. BACKUP_DIR, GITLAB_CONFIG_DIR,
# GITLAB_DATA_DIR, and the key paths derive from its directory by default.
# Script default: <script-dir>/../../test-gitlab-server/docker-compose.yml.
COMPOSE_FILE=/path/to/checkout/test-gitlab-server/docker-compose.yml

# BACKUP_DIR — local sets land here as <BACKUP_DIR>/<ts>/.
# Default: <compose-dir>/backups. Must already exist and be writable
# (mkdir -p it); the script creates only staging dirs and the lock inside.
BACKUP_DIR=/path/to/checkout/test-gitlab-server/backups

# GITLAB_CONTAINER — container name for `docker exec` capture and
# `docker inspect` validation. Must match compose container_name, not the
# service name (the script default `gitlab` fails on the POC stack).
GITLAB_CONTAINER=test-gitlab-server

# GITLAB_CONFIG_DIR — host-side bind of the whole /etc/gitlab volume
# (gitlab.rb, gitlab-secrets.json, TLS certs, SSH host keys).
# Default: <compose-dir>/volumes/config.
GITLAB_CONFIG_DIR=/path/to/checkout/test-gitlab-server/volumes/config

# GITLAB_DATA_DIR — host-side bind of the GitLab data volume; the native
# tarball is read from <data-dir>/backups/. Default: <compose-dir>/volumes/data.
GITLAB_DATA_DIR=/path/to/checkout/test-gitlab-server/volumes/data

# NAS_HOST / NAS_USER / NAS_DIR — where rsync ships the set, and the remote
# root it lands under. NAS_DIR must be absolute.
# POC address below; replace with your NAS host (script default `nas`).
NAS_HOST=192.168.124.115
NAS_USER=backup
NAS_DIR=/backups/gitlab

# SSH_KEY_FILE — Ed25519 private key for rsync/ssh to the NAS. Path only.
# Default: <compose-dir>/keys/id_backup_ed25519. Keep it mode 600.
SSH_KEY_FILE=/path/to/checkout/test-gitlab-server/keys/id_backup_ed25519

# AGE_PUBKEY_FILE — NAS age public key (single age1 line), supplied
# out-of-band before the first run. Path only; the NAS private key must never
# exist on this host. Exactly one line — a trailing blank line fails validation.
# Default: <compose-dir>/keys/nas.agepub.
AGE_PUBKEY_FILE=/path/to/checkout/test-gitlab-server/keys/nas.agepub

# AGE_BIN — age binary sealing the set. Default: <script-dir>/vendor/age.
AGE_BIN=/path/to/checkout/gitlab-backup/backup/vendor/age

# VERBOSE — 1 sends tool chatter to stderr; anything else silences it.
# Stdout stays grammar-only in both modes.
VERBOSE=0

# ENV_FILE — path of this file. To point elsewhere, export ENV_FILE in the
# real environment (the file cannot redirect its own loading).
ENV_FILE=/path/to/checkout/gitlab-backup/backup/backup.env
